{
  "name": "slabcalc",
  "productName": "SlabCalc",
  "version": "1.0.0",
  "description": "Concrete estimating and proposals",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "vendor": "node scripts/vendor.js",
    "icon": "electron scripts/make-icon.js",
    "start": "npm run vendor && electron .",
    "dist": "npm run vendor && npm run icon && electron-builder --mac --arm64"
  },
  "build": {
    "appId": "com.slabcalc.app",
    "productName": "SlabCalc",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "SlabCalc.html",
      "vendor/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false
    }
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "leaflet": "^1.9.4"
  }
}
